{
  "name": "cutting-optimization",
  "version": "1.0.0",
  "description": "Sistema completo de otimização de corte bidimensional",
  "main": "frontend/main.js",
  "scripts": {
    "install:backend": "cd backend && pip install -r requirements.txt && pip install -e .",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "start:backend": "cd backend && python main.py --interactive",
    "start:frontend": "cd frontend && npm start",
    "start:electron": "npm run electron --workspace=frontend",
    "test:backend": "python -m unittest discover -s backend/tests -p \"test_*.py\"",
    "test:frontend": "npm test --workspace=frontend --",
    "build:frontend": "cd frontend && npm run build",
    "dist:frontend": "cd frontend && npm run dist",
    "build:backend-exe": "cd backend && python build_exe_windows.py",
    "build:windows-installer": "scripts\\build-windows-installer.bat",
    "clean": "rm -rf frontend/node_modules backend/build backend/dist frontend/dist backend/cutting-optimization-backend.exe",
    "test:desktop": "node --test frontend/tests/*.test.js",
    "generate:branding": "python scripts/generate_branding.py",
    "dev:electron": "npm run electron-dev --workspace=frontend",
    "test:cloud": "npm test --prefix cloudflare",
    "dev:cloud": "npm run dev --prefix cloudflare",
    "check:cloud": "npm run check --prefix cloudflare"
  },
  "keywords": [
    "cutting",
    "optimization",
    "2d",
    "python",
    "electron",
    "react"
  ],
  "author": "Douglas Cesario",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/douglasc-c/cutting-optimization.git"
  },
  "bugs": {
    "url": "https://github.com/douglasc-c/cutting-optimization/issues"
  },
  "homepage": "https://github.com/douglasc-c/cutting-optimization#readme",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=8.0.0"
  },
  "workspaces": [
    "frontend"
  ]
}
