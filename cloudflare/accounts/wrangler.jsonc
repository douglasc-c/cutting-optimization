{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cutting-accounts",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "services": [{ "binding": "VERSIONS", "service": "cutting-versions" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cutting-accounts",
      "database_id": "4d46b37f-6007-44f4-91b2-0ee567979731",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "EMAIL_FROM": "Cutting Optimization <acesso@cutting-optimization.com>" },
  "triggers": { "crons": ["0 3 * * *"] },
}
